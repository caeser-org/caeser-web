---
import AsciiHands from '../components/AsciiHands.astro';
import FactsRibbon from '../components/FactsRibbon.astro';
import InvestigationFlow from '../components/InvestigationFlow.astro';
import DeeperInvestigation from '../components/DeeperInvestigation.astro';
import ClosingFooter from '../components/ClosingFooter.astro';
import DemoVideo from '../components/DemoVideo.astro';
import '@fontsource-variable/inter/index.css';
import 'lenis/dist/lenis.css';
import '../styles/global.css';
---
<!doctype html>
<html lang="en" data-type="software">
<head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Caeser — Investigate failed Go CI runs</title>
<meta name="description" content="Connect failed Go CI logs to source evidence, ranked function leads, and an inspectable investigation report."/>
<meta name="page-type" content="software"/><meta name="site-kind" content="software"/>
<meta name="theme-color" content="#f8f8f6"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="header">
<a href="/" class="brand" aria-label="Caeser home"><img class="brand-logo" src="/logo-mark.webp" width="24" height="17" decoding="async" alt="" aria-hidden="true"/>caeser<span class="brand-dot">.</span></a>
<nav aria-label="Main navigation"><a href="/docs/runtime-architecture/">Architecture <span>↗</span></a><a href="/docs/">Docs <span>↗</span></a></nav>
<a class="repo" href="https://github.com/caeser-org/ceaser"><svg class="repo-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.04-.02-2.05-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.49.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.95 0-1.31.47-2.39 1.24-3.23-.12-.31-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.66 1.65.24 2.87.12 3.18.77.84 1.24 1.92 1.24 3.23 0 4.62-2.8 5.65-5.48 5.95.43.37.81 1.1.81 2.22 0 1.6-.01 2.9-.01 3.29 0 .32.21.7.82.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5z"/></svg>View source</a>
</header>
<main id="main">
<div class="hero-track"><section class="hero" aria-labelledby="hero-title" data-enter>
<h1 id="hero-title"><span class="headline-start">Investigate failure.</span><span class="headline-end"><span>Follow the evidence.</span></span></h1>
<div class="art-stage"><div class="coordinates" aria-hidden="true">+<br/><br/>·<br/><br/>·</div><AsciiHands/><span class="art-index" aria-hidden="true">FIG. 001 / SOURCE → SIGNAL</span><div class="stray stray-one" aria-hidden="true">· &nbsp; +<br/> &nbsp; : ·<br/>+ &nbsp; .</div><div class="stray stray-two" aria-hidden="true">. :<br/> &nbsp; + &nbsp; ·</div></div>
<div class="hero-bottom">
<div class="actions"><a class="button primary" href="/docs/installation/">Get started <span>↗</span></a><a class="button secondary" href="/docs/">Read the docs <span>↗</span></a></div>
</div>
<FactsRibbon/>
</section></div>
<InvestigationFlow/>
<DeeperInvestigation/>
<DemoVideo sources={[{ src: '/demo/ceaser-demo.webm', type: 'video/webm' }, { src: '/demo/ceaser-demo.mp4', type: 'video/mp4' }]} poster="/demo/ceaser-demo-poster.webp"/>

</main>
<ClosingFooter/>
<script>
  import Lenis from 'lenis';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let scrolling: Lenis | undefined;
  const configureScrolling = () => {
    scrolling?.destroy();
    scrolling = undefined;
    if (reduced.matches) return;
    scrolling = new Lenis({
      autoRaf: true,
      smoothWheel: true,
      lerp: 0.06,
      wheelMultiplier: 0.9,
      syncTouch: false,
      touchMultiplier: 1,
      overscroll: true,
      anchors: { offset: -24 },
      prevent: node => node.hasAttribute('data-native-scroll'),
    });
  };
  configureScrolling();
  reduced.addEventListener('change', configureScrolling);
  document.addEventListener('astro:before-swap', () => {
    scrolling?.destroy();
    reduced.removeEventListener('change', configureScrolling);
  }, { once: true });
</script>
</body>
</html>
<style>
:global(html){background:#f8f8f6}:global(body){margin:0;color:#171717;font-family:'Inter Variable',Arial,sans-serif;font-weight:500;-webkit-font-smoothing:antialiased}:global(*){box-sizing:border-box}:global(a){color:inherit;text-decoration:none}:global(a:focus-visible),:global(button:focus-visible){outline:2px solid #111;outline-offset:4px}.skip{position:absolute;top:-80px;left:20px;padding:12px;background:white;z-index:10}.skip:focus{top:10px}
.header{max-width:1800px;width:calc(100% - 6vw);margin:18px auto 0;height:56px;border-radius:999px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;background:#080909;color:#eeeeea;position:relative;z-index:5}.brand{font-size:18px;letter-spacing:-1px;font-weight:550;display:flex;align-items:center;gap:10px;min-height:40px}.brand-logo{width:24px;height:auto;display:block}.brand-dot{margin-left:-10px}nav{display:flex;gap:30px;font-size:14px}nav a,.repo{display:flex;align-items:center;gap:12px;min-height:32px}nav a span,.repo-icon{color:#a1a5a2}.repo{font-size:14px;gap:12px;transition:color .2s}.repo-icon{width:14px;height:14px;display:block}.repo:hover{color:#a1a5a2}
.hero-track{height:210svh;position:relative}.hero{max-width:1600px;margin:auto;padding:20px 7vw 0;position:sticky;top:0;height:calc(100svh - 56px);min-height:620px;display:flex;flex-direction:column;overflow:hidden}.eyebrow{display:flex;align-items:center;gap:10px;font:14px 'Inter Variable',Arial,sans-serif;letter-spacing:.9px;color:#50564c}.cross{font:16px 'Inter Variable',Arial,sans-serif;color:#171717}.edition{margin-left:auto;font-size:14px}h1{font-family:'Inter Variable',Arial,sans-serif;font-weight:400;letter-spacing:-.05em;font-size:clamp(38px,4.1vw,62px);line-height:1.1;margin:26px 0 0;position:relative;z-index:2;pointer-events:none}.headline-start,.headline-end{display:block}.headline-end{text-align:right;margin-top:clamp(250px,36svh,340px)}.art-stage{position:absolute;top:85px;left:0;right:0;height:clamp(420px,64svh,650px);z-index:1;pointer-events:none}.coordinates,.art-index,.stray{display:none}
.hero-bottom{display:flex;justify-content:flex-end;margin-top:auto;padding:22px 0 26px;z-index:3}.actions{display:flex;gap:10px}.button{display:flex;align-items:center;justify-content:space-between;gap:32px;min-height:52px;padding:0 30px;border:1px solid #222;border-radius:999px;text-transform:uppercase;font:14px 'Inter Variable',Arial,sans-serif;letter-spacing:.2px;transition:transform .2s,background .2s,color .2s}.primary{background:#171717;color:#fff}.secondary{border-color:#c5c5c0;background:#f8f8f6}.button:hover{transform:translateY(-2px);background:#333;color:#fff}.button:active{transform:translateY(1px)}
.fact-symbol{font:17px 'Inter Variable',Arial,sans-serif;font-weight:600;color:#171717}
.scope-section{padding:95px 7vw 105px;min-height:80svh;background:#efefec}.scope-label{font:14px 'Inter Variable',Arial,sans-serif;letter-spacing:1px;color:#50564c}.scope-section h2{font:400 clamp(38px,4.5vw,66px)/1.1 'Inter Variable',Arial,sans-serif;letter-spacing:-.04em;margin:38px 0}.scope-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;max-width:850px;margin-bottom:35px}.scope-grid p{font-size:14px;line-height:1.9;color:#50564c}.scope-section .button{width:max-content}footer{padding:20px 7vw;display:flex;justify-content:space-between;background:#efefec;font:14px 'Inter Variable',Arial,sans-serif;letter-spacing:.5px;color:#50564c}nav a:hover,.repo:hover,footer a:hover{text-decoration:underline;text-underline-offset:5px}
@media(max-height:760px) and (min-width:801px){.hero{padding-top:16px}h1{font-size:clamp(36px,3.7vw,56px);margin-top:20px}.headline-end{margin-top:220px}.art-stage{top:78px;height:440px}.hero-bottom{padding:18px 0}}
@media(max-width:800px){.hero{padding-left:5vw;padding-right:5vw}.header{width:calc(100% - 6vw);padding:0 22px}nav{gap:18px}.headline-end{margin-top:250px}.art-stage{top:100px;height:440px;left:0;right:0}.fact-symbol{font-size:14px}.scope-grid{gap:30px}}
@media(max-width:500px){.header{height:52px;width:calc(100% - 6vw);padding:0 18px}.brand{font-size:18px;gap:8px}.brand-logo{width:20px}nav{gap:14px;font-size:14px}nav a{gap:5px}.repo{display:none}.hero{padding-top:18px;min-height:620px}.eyebrow{font-size:14px;letter-spacing:.15px}.edition{font-size:14px}h1{font-size:clamp(29px,7.7vw,38px);margin-top:26px}.headline-end{margin-top:210px}.art-stage{top:95px;height:280px}.hero-bottom{padding:24px 0;justify-content:stretch}.actions{width:100%}.button{flex:1;gap:12px;min-height:50px;font-size:14px;padding:0 18px}.fact-symbol{font-size:14px}.scope-section{padding:65px 5vw}.scope-grid{grid-template-columns:1fr;gap:12px}.scope-section h2{font-size:39px}.scope-grid p{font-size:14px}footer{padding:18px 5vw;font-size:14px}}
@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}.hero-track{height:auto}.hero{position:relative}*{transition:none!important}}
.button,nav a,.repo{font-weight:550}.scope-grid p{font-weight:500;color:#454940}
h1{font-weight:600;letter-spacing:-.045em;line-height:1.12}.hero{max-width:1920px;padding-inline:4vw}.header{max-width:1920px;width:calc(100% - 4vw)}.button{font-size:14px}.scope-section{padding-inline:4vw}.scope-grid{max-width:1100px}.scope-grid p{font-size:17px}
@media(max-width:500px){.hero{padding-inline:5vw}nav{font-size:14px;gap:16px}.brand{font-size:20px}.header{padding-inline:18px}h1{font-size:clamp(30px,7.4vw,38px)}.button{font-size:13px}}
@media(max-width:430px){.actions{flex-direction:column}.button{min-height:46px}.hero{min-height:720px}}
@media(max-width:500px){.hero-track{height:145svh}.hero{height:auto;min-height:0;padding-right:7vw;padding-bottom:12px}.headline-end{margin-top:242px}.hero-bottom{margin-top:56px;padding-top:16px;padding-bottom:24px}}
</style>
