---
const lines = ['--- FAIL:','TestLateRouteRegistrationSkippedNodes','','Observed stack:','node.getValue','tree.go:418','','Engine.handleHTTPRequest','gin.go:719','','Engine.ServeHTTP','gin.go:691'];
---
<section class="investigation" aria-labelledby="investigation-title">
  <header><span class="eyebrow">FROM FAILURE TO EVIDENCE</span><h2 id="investigation-title">Start with the failed CI run.</h2></header>
  <div class="flow">
    <svg class="streams" fill="none" aria-hidden="true">{Array.from({length:27},(_,i)=><g><path data-line={i}/><rect x="-4" y="-2" width="8" height="4"><animateMotion data-motion={i} dur={`${4+i%5*.4}s`} begin={`${-i*.63}s`} repeatCount="indefinite" rotate="auto"/></rect></g>)}</svg>
    <article class="input card"><h3><span aria-hidden="true">&gt;_</span> CI run</h3><div class="log" tabindex="0" role="region" aria-label="CI failure log; focus to pause automatic scrolling"><div class="log-scroll">{[0,1].map(copy=><div class="log-copy" aria-hidden={copy===1?'true':undefined}>{lines.map(line=><div class:list={{strong:line.includes('FAIL')||line.startsWith('Test')}}>{line||'\u00a0'}</div>)}</div>)}</div></div><span class="foot">FAILED RUN / LOGS + ARTIFACTS</span></article>
    <div class="junction" aria-hidden="true"></div>
    <article class="assistant card"><span class="assistant-tag">AI ASSISTANT</span><h3><span aria-hidden="true">✳</span> AI debugging / review assistant</h3><p class="context"><b>Context:</b> logs and supplied source</p><ul><li>Read the logs and supplied context</li><li>Explore hypotheses with your tools</li><li>Propose a change to verify</li></ul><span class="foot">CAPABILITIES DEPEND ON YOUR ASSISTANT</span></article>
    <article class="analysis card small"><h3>AI analysis</h3></article>
    <article class="debug card small"><h3>Debug &amp; trace</h3></article>
    <article class="sandbox card small"><h3>Sandbox<br/>&amp;<br/>checks</h3><svg class="probe-grid" viewBox="0 0 60 52" fill="none" aria-hidden="true"><path d="M7 13 23 4 54 4 39 13Z" fill="#eeeee9" stroke="#98988e"/><path d="M39 13 54 4 54 39 39 48Z" fill="#e1e1da" stroke="#98988e"/><path d="M7 13H39V48H7Z" fill="#fafaf7" stroke="#98988e"/>{Array.from({length:30},(_,i)=><rect class="probe-cell" x={11+i%5*5} y={18+Math.floor(i/5)*4.8} width="2" height="2" style={`--delay:${(i%7)*-.4}s`}/>)}</svg></article>
    <article class="report card small caeser-report"><h3>Final report</h3><span class="preview-label">EVIDENCE-BACKED</span><div class="report-preview"><strong>Failed Go test</strong><p>Observed <span>Test failure + stack</span></p><p>Source lead <span>node.getValue · tree.go:418</span></p><p>Assessment <span>Inferred · needs verification</span></p></div><a href="/docs/reports/">Report formats <span aria-hidden="true">↗</span></a></article>
    <article class="report card small assistant-report"><h3>Assistant reply</h3><span class="preview-label">TYPICAL RESPONSE</span><div class="report-preview"><strong>Looks like a race condition</strong><p>Likely <span>routes registered after the server starts</span></p><p>Suggestion <span>review the router setup and add a test</span></p><p>Confidence <span>needs verification</span></p></div></article>
  </div>
  <footer><p>Continue in your assistant with the exported investigation brief.</p><a href="/docs/reports/">Read about reports <span aria-hidden="true">↗</span></a></footer>
</section>
<style>
.investigation{padding:80px 4vw 55px;background:#f8f8f6;color:#292926;font-family:'Inter Variable',Arial,sans-serif;overflow:hidden}.eyebrow{font-size:12px;font-weight:650;letter-spacing:.1em;color:#62625b}h2{font-size:clamp(34px,4vw,58px);line-height:1.13;letter-spacing:-.04em;margin:18px 0 35px;font-weight:600}.flow{position:relative;height:650px;max-width:1600px;margin:auto}.streams{position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none}.streams path{stroke:#aaa9a0;stroke-width:1.1}.streams rect{fill:#f8f8f6;stroke:#73736b;stroke-width:1.1}.card{position:absolute;box-sizing:border-box;background:#fbfbf9;border:1px solid #8f8f88;border-radius:11px;padding:25px;z-index:1;box-shadow:0 8px 25px -24px #222}h3{font-size:17px;font-weight:650;line-height:1.4;margin:0;letter-spacing:-.025em}.input{left:8%;top:19%;width:25%;height:65%;box-shadow:-8px 8px 0 -1px #f8f8f6,-8px 8px 0 #bdbdb5,-16px 16px 0 -1px #f8f8f6,-16px 16px 0 #d1d1ca}.input h3,.assistant h3{border-bottom:1px solid #c9c9c1;padding-bottom:20px}.input h3 span,.assistant h3 span{margin-right:10px}.log{font:500 12px/1.9 ui-monospace,SFMono-Regular,Menlo,monospace;margin:35px 0 25px;overflow-wrap:anywhere}.strong{font-weight:700}.foot{display:block;font:500 11px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.02em;color:#64645b}.assistant{left:50%;top:0;width:35%;min-height:270px}.assistant ul{font-size:13px;line-height:1.8;margin:18px 0 23px;padding-left:15px}.context{font:11px/1.6 ui-monospace,SFMono-Regular,Menlo,monospace;padding:12px;background:#ecece8;border-radius:4px;margin:18px 0 0;color:#67675d}.notes{position:absolute;box-sizing:border-box;margin:0;padding-left:20px;font-size:13px;line-height:1.75;color:#464640;z-index:1}.notes li{margin:0 0 12px}.assistant-notes{left:86%;top:12%;width:14%}.small{display:flex;align-items:center;justify-content:center;text-align:center;padding:15px}.analysis{left:47%;top:62%;width:12%;height:13%}.debug{left:47%;top:82%;width:12%;height:13%}.sandbox{left:63%;top:69%;width:6%;height:22%;flex-direction:column}.sandbox h3{font-size:15px;line-height:1.25}.check{font-size:28px;line-height:1;margin-top:10px}.report{left:73%;top:66%;width:15%;height:25%}.engine-notes{left:90%;top:65%;width:12%;border-left:1px solid #a7a79e;padding-left:18px}.junction{position:absolute;left:39%;top:48%;height:64px;width:18px;border:1px solid #8f8f85;border-radius:3px;background:#fbfbf9;z-index:1}footer{display:flex;align-items:center;justify-content:space-between;gap:25px;margin-top:35px}footer p{font-size:13px;line-height:1.7;color:#63635a;margin:0}footer a{display:inline-flex;align-items:center;gap:24px;min-height:44px;font-size:12px;color:#41413b;text-decoration:none}footer a:hover{text-decoration:underline}a:focus-visible{outline:2px solid;outline-offset:5px}
@media(min-width:1600px){.flow{height:720px}.log{font-size:13px}.assistant ul,.notes{font-size:14px}}
@media(max-width:1100px){.investigation{padding-left:3vw;padding-right:3vw}.flow{height:650px}.card{padding:18px}.input{left:5%;width:27%}.assistant{left:44%;width:32%}.assistant-notes{display:none}.engine-notes{font-size:12px;left:89%;width:12%;padding-left:12px}.small h3{font-size:15px}.sandbox{width:7%;left:62%}.sandbox h3{font-size:13px}.log{font-size:11px}}
@media(max-width:760px){.investigation{padding:60px 6vw 35px}.flow{height:auto;display:grid;grid-template-columns:1fr 1fr;gap:26px}.junction{display:none}.card,.notes{position:relative;inset:auto;width:auto;height:auto}.input,.assistant,.engine-notes{grid-column:1 / -1}.input{margin:0 0 10px 16px}.log{font-size:13px;line-height:1.8}.card{padding:25px}.small{min-height:110px}.sandbox h3{font-size:16px}.report h3{font-size:18px}.engine-notes{font-size:14px;padding:15px 0 0 20px;border-left:0;border-top:1px solid #c8c8be}.assistant ul{font-size:14px}.context{font-size:12px}footer{align-items:flex-start;flex-direction:column;gap:6px}}
</style>
<style>
.streams rect{fill:#171717;stroke:#171717}.probe-grid{width:54px;max-width:100%;margin-top:14px;overflow:visible}.probe-cell{fill:#202020;animation:probe-glow 2.8s ease-in-out infinite;animation-delay:var(--delay);transform-box:fill-box;transform-origin:center}.report{top:61%;height:35%;flex-direction:column;align-items:stretch;text-align:left;padding:17px}.report h3{font-size:17px}.preview-label{font-size:10px;letter-spacing:.09em;color:#727269;margin:6px 0 12px}.report-preview{border-top:1px solid #d7d7ce;padding-top:10px;font-size:10px;line-height:1.5}.report-preview strong{font-size:11px}.report-preview p{margin:8px 0;color:#66665d}.report-preview p span{display:block;color:#30302b;overflow-wrap:anywhere}.report a{display:flex;justify-content:space-between;gap:8px;margin-top:10px;font-size:10px;color:#252522;text-decoration:underline;text-underline-offset:3px}@keyframes probe-glow{0%,100%{opacity:.3;filter:drop-shadow(0 0 0 #2220)}50%{opacity:1;filter:drop-shadow(0 0 3px #2229);transform:scale(1.2)}}@media(max-width:760px){.report{top:auto;height:auto;min-height:240px}.report-preview{font-size:11px}.report a{font-size:12px;min-height:44px;align-items:center}.probe-grid{width:65px}.preview-label{font-size:11px}}@media(prefers-reduced-motion:reduce){.probe-cell{animation:none;opacity:.8}}
.report{min-height:270px}
.input{display:flex;flex-direction:column}.input h3,.input .foot{flex-shrink:0}.input .log{flex:1;min-height:0;overflow:hidden;margin:25px 0 20px;mask-image:linear-gradient(transparent,#000 7%,#000 92%,transparent)}.log-scroll{animation:ci-log-scroll 22s linear infinite;will-change:transform}.log-copy{padding-bottom:24px}.log:focus .log-scroll,.log:hover .log-scroll,[data-motion-paused] .log-scroll{animation-play-state:paused}.log:focus-visible{outline:1px solid #73736b;outline-offset:5px}@keyframes ci-log-scroll{to{transform:translateY(-50%)}}@media(prefers-reduced-motion:reduce){.log-scroll{animation:none}}@media(max-width:760px){.input{height:420px}}
.sandbox{background:transparent;border:0;box-shadow:none;padding:0;overflow:visible}.sandbox h3{position:absolute;bottom:calc(100% + 12px);left:50%;transform:translateX(-50%);width:130px;font-size:13px;line-height:1.4}.sandbox h3 br{display:none}.sandbox h3 br::after{content:' '}.sandbox .probe-grid{width:100%;max-width:none;height:100%;margin:0;filter:drop-shadow(0 8px 9px #20202018)}
.assistant{left:46%;width:30%;padding:26px 28px}.assistant ul{font-size:15px;line-height:1.9}.assistant h3{font-size:19px}.context{font-size:12px}.analysis,.debug{left:46%;width:14%}.sandbox{left:64%;width:8%}.report{left:78%;width:21%;padding:23px;min-height:285px}.assistant-report{top:2%;height:auto;min-height:0}.report-preview{font-size:12px}.report-preview strong{font-size:13px}.report a{font-size:12px}.preview-label{font-size:11px}
@media(max-width:760px){.sandbox{min-height:150px;padding-top:25px}.sandbox h3{top:0;bottom:auto;width:100%}.sandbox .probe-grid{width:110px;height:110px}}
@media(max-width:760px){.assistant,.analysis,.debug,.sandbox,.report{left:auto;width:auto}.assistant{padding:25px;order:9}.assistant h3{font-size:17px}.sandbox{grid-column:1 / -1;min-height:0;padding:24px;background:#fbfbf9;border:1px solid #8f8f88;border-radius:11px;box-shadow:0 8px 25px -24px #222;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px}.sandbox h3{position:static;transform:none;width:auto;font-size:17px}.sandbox .probe-grid{width:120px;height:120px}.report{grid-column:1 / -1;min-height:260px}.report-preview{font-size:13px}.report-preview strong{font-size:14px}}
.assistant{background:#fdf6e0;border-color:#e6d39a}
.assistant-tag{display:inline-block;margin:0 0 14px;font:650 10px/1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em;color:#8a7a2e;background:#f8edc2;border:1px solid #e7d69a;border-radius:999px;padding:5px 10px}
.assistant-report{background:#fdf6e0;border-color:#e6d39a}
.assistant-report .preview-label{color:#8a7a2e}
@media(max-width:760px){.assistant,.analysis,.debug,.sandbox{display:none}.assistant-report{order:1}.caeser-report{order:2}.report{min-height:0}}

.investigation footer{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;will-change:opacity,transform}
.investigation footer[data-revealed]{opacity:1;transform:none}
.investigation footer p{font-size:clamp(18px,1.6vw,22px);line-height:1.55;letter-spacing:-.01em;color:#3a3a3a;max-width:62ch}
@media(max-width:760px){.investigation footer p{font-size:16px}}
@media(prefers-reduced-motion:reduce){.investigation footer{opacity:1;transform:none;transition:none}}
</style>
<script>
const section=document.querySelector<HTMLElement>('.investigation');
if(section){
 const svg=section.querySelector<SVGSVGElement>('.streams')!;let frame=0,visible=false;
 const reduced=matchMedia('(prefers-reduced-motion: reduce)');
 const motion=()=>{const paused=!visible||reduced.matches||document.hidden;section.toggleAttribute('data-motion-paused',paused);if(paused)svg.pauseAnimations();else svg.unpauseAnimations()};
 const layout=()=>{
  const flow=section.querySelector<HTMLElement>('.flow')!,bounds=flow.getBoundingClientRect();
  const box=(s:string)=>{const r=section.querySelector<HTMLElement>(s)!.getBoundingClientRect();return{x:r.left-bounds.left,y:r.top-bounds.top,w:r.width,h:r.height}};
  const input=box('.input'),assistant=box('.assistant'),analysis=box('.analysis'),debug=box('.debug'),sandbox=box('.sandbox'),caeserReport=box('.caeser-report'),assistantReport=box('.assistant-report');
  const curve=(x:number,y:number,tx:number,ty:number)=>`M${x} ${y} C${x+(tx-x)*.55} ${y},${tx-(tx-x)*.45} ${ty},${tx} ${ty}`;
  const paths:string[]=[];
  if(matchMedia('(max-width:760px)').matches){
   type B=typeof input;const cx=(b:B,side:number)=>b.x+b.w*side,bottom=(b:B)=>b.y+b.h;
   const link=(ax:number,ay:number,bx:number,by:number)=>`M${ax} ${ay} C${ax} ${ay+(by-ay)*.5},${bx} ${ay+(by-ay)*.5},${bx} ${by}`;
   paths.push(link(cx(input,.5),bottom(input),cx(assistantReport,.5),assistantReport.y));
   paths.push(link(cx(assistantReport,.5),bottom(assistantReport),cx(caeserReport,.5),caeserReport.y));
  }else{
   const hub=box('.junction');
   for(let i=0;i<12;i++)paths.push(curve(-bounds.left-20,(i/11)*bounds.height,input.x,input.y+input.h*(.28+i*.04)));
   for(let i=0;i<4;i++)paths.push(curve(input.x+input.w,input.y+input.h*(.4+i*.07),hub.x,hub.y+hub.h*(.2+i*.2)));
   paths.push(curve(input.x+input.w,input.y+input.h*.5,assistant.x,assistant.y+assistant.h*.5));
   for(const target of [analysis,debug])for(let i=0;i<2;i++)paths.push(curve(hub.x+hub.w,hub.y+hub.h*(.65+i*.18),target.x,target.y+target.h*(.45+i*.15)));
   for(const source of [analysis,debug])paths.push(curve(source.x+source.w,source.y+source.h*.5,sandbox.x,sandbox.y+sandbox.h*(source===analysis?.3:.7)));
   for(let i=0;i<2;i++)paths.push(curve(sandbox.x+sandbox.w,sandbox.y+sandbox.h*(.4+i*.15),caeserReport.x,caeserReport.y+caeserReport.h*(.4+i*.15)));
   paths.push(curve(assistant.x+assistant.w,assistant.y+assistant.h*.5,assistantReport.x,assistantReport.y+assistantReport.h*.5));
  }
  svg.setAttribute('viewBox',`0 0 ${bounds.width} ${bounds.height}`);
  svg.querySelectorAll<SVGPathElement>('[data-line]').forEach((p,i)=>p.setAttribute('d',paths[i]??''));
  svg.querySelectorAll<SVGAnimateMotionElement>('[data-motion]').forEach((m,i)=>{const rect=m.closest('rect');const keep=paths[i]!==undefined;if(rect)rect.style.display=keep?'':'none';if(keep)m.setAttribute('path',paths[i]);});
 };
 const resize=new ResizeObserver(()=>{cancelAnimationFrame(frame);frame=requestAnimationFrame(layout)});resize.observe(section);
 const observer=new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;motion()});observer.observe(section);
 const footer=section.querySelector<HTMLElement>('footer');
 const reveal=footer?new IntersectionObserver(entries=>{footer.toggleAttribute('data-revealed',entries[0].isIntersecting)},{threshold:.35,rootMargin:'0px 0px -8% 0px'}):null;
 reveal?.observe(footer!);
 reduced.addEventListener('change',motion);document.addEventListener('visibilitychange',motion);layout();motion();
 document.addEventListener('astro:before-swap',()=>{cancelAnimationFrame(frame);resize.disconnect();observer.disconnect();reveal?.disconnect();reduced.removeEventListener('change',motion);document.removeEventListener('visibilitychange',motion)},{once:true});
}
</script>
